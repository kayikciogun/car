{
  "package_name": "synthwave_demo",
  "version": "1.0.0",
  "description": "Demo synthwave package for adaptive drive music",
  "bpm": 120,
  "stems": ["pad", "kick", "perc", "bass", "lead"],
  "intensity_mapping": {
    "pad": [0.5, 0.5],
    "kick": [0.12, 0.32],
    "perc": [0.32, 0.50],
    "bass": [0.45, 0.67],
    "lead": [0.68, 0.90]
  },
  "fx_chain": ["lowpass", "delay"],
  "filter_params": {
    "lowpass": {
      "cutoff_min": 400,
      "cutoff_max": 6400,
      "q": 3.0
    },
    "delay": {
      "time_ms": 250,
      "feedback": 0.35,
      "wet": 0.3
    }
  }
}
